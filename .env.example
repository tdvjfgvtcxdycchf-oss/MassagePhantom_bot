API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# === Bot (от BotFather) ===
BOT_TOKEN=1234567890:AABBccDDeeffGGhhIIjjKKllMMnnOOppQQ

# === Настройки ===
# Твой Telegram user_id (получить у @userinfobot)
OWNER_ID=123456789

# Ключ шифрования сессий — ОБЯЗАТЕЛЬНО
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# Стоимость Premium в Stars (по умолчанию 100)
PREMIUM_PRICE=100

# Путь к БД (по умолчанию data/transparency.db, менять не обязательно)
# DB_PATH=data/transparency.db

# Прокси (если Telegram заблокирован на сервере)
